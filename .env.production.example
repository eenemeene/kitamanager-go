# KitaManager — production env template.
# Copy to `.env` and replace every REPLACE_ME. The API refuses to start if any
# required value is missing, shorter than the minimum, or matches a known
# placeholder string.

# --- Database ---
DB_HOST=postgres.internal
DB_PORT=5432
DB_USER=kitamanager
# Generate: openssl rand -hex 24
DB_PASSWORD=REPLACE_ME
DB_NAME=kitamanager
# Use verify-full when the DB has a verifiable cert, otherwise 'require'.
DB_SSLMODE=require

# --- Server ---
SERVER_PORT=8080

# --- Auth ---
# HMAC key used to derive the double-submit CSRF token from the session
# cookie value. Generate: openssl rand -hex 32
# Must be at least 32 characters and not a known placeholder.
#
# UPGRADING FROM A PRE-CSRF_HMAC_KEY RELEASE: this value used to live under
# JWT_SECRET. The fallback has been retired — rename the var in your .env
# (the value can stay the same). The API now refuses to start if
# CSRF_HMAC_KEY is unset, even if JWT_SECRET is still set.
CSRF_HMAC_KEY=REPLACE_ME
# 32-byte key for AES-256-GCM encryption of TOTP secrets at rest.
# Generate: openssl rand -hex 32 (exactly 64 hex chars).
# Rotating this invalidates all stored TOTP factors; affected users must
# re-enroll. Back up before rotating.
TOTP_ENCRYPTION_KEY=REPLACE_ME
# Shown in the user's authenticator app after scanning a QR code.
TOTP_ISSUER=KitaManager

# WebAuthn / security-key support. Optional — leave all three UNSET to
# disable WebAuthn enrolment entirely. If any one is set, ALL three
# must be set; the API refuses to start otherwise. Rotating RP_ID
# invalidates every stored credential across the deployment.
#
# Browser requirements (enforced by the WebAuthn API, not by this app):
#   - RP_ID must be a DNS-style hostname. IP addresses DO NOT work —
#     browsers throw SecurityError on navigator.credentials.create().
#     The only IP-shaped exception is the literal "localhost".
#   - The login page must be served over HTTPS. http:// origins are
#     refused; the only http exception is http://localhost.
# If the deployment is reachable only by IP (no internal DNS, no
# HTTPS cert), leave this block commented out — users keep TOTP +
# backup codes, which remain fully supported.
#
#   - WEBAUTHN_RP_ID: the Relying Party identifier. Bare hostname, no
#     scheme, no port. The login origin must be a registrable suffix
#     of this value.
#   - WEBAUTHN_RP_NAME: display name shown in the browser's passkey
#     picker and on the user's authenticator.
#   - WEBAUTHN_ORIGINS: comma-separated https://host[:port] list. Each
#     entry must match the browser's Origin header exactly — no
#     wildcards, no trailing slash.
# WEBAUTHN_RP_ID=kitamanager.yourdomain.example
# WEBAUTHN_RP_NAME=KitaManager
# WEBAUTHN_ORIGINS=https://kitamanager.yourdomain.example

SECURE_COOKIES=true

# --- First-time admin seeding ---
# The seeded admin should rotate this password on first login.
SEED_ADMIN_EMAIL=admin@yourdomain.example
SEED_ADMIN_PASSWORD=REPLACE_ME
SEED_ADMIN_NAME=Administrator
SEED_RBAC_POLICIES=true
# Do not set SEED_TEST_DATA in production.
# SEED_TEST_DATA=false

# Optional: import default government funding plan at startup.
# GOVERNMENT_FUNDING_SEED_PATH=configs/government-fundings/berlin.yaml
# GOVERNMENT_FUNDING_SEED_STATE=berlin

# --- CORS ---
# Exact origins only. Wildcard (*) combined with credentials is rejected.
CORS_ALLOW_ORIGINS=https://kitamanager.yourdomain.example
CORS_ALLOW_CREDENTIALS=true

# --- Reverse proxy ---
# Comma-separated CIDRs of the proxies in front of the API. Without this, the
# app does not honor X-Forwarded-* headers. 0.0.0.0/0 and ::/0 are rejected
# at startup — they would defeat per-IP rate limiting.
TRUSTED_PROXIES=10.0.0.0/8

# --- Rate limiting ---
LOGIN_RATE_LIMIT_PER_MINUTE=5
API_RATE_LIMIT_PER_MINUTE=60

# --- Production gate opt-outs (leave commented) ---
# These exist only as conscious escape hatches for environments where one of
# the production gates can't be satisfied (e.g. a LAN where the DB really
# cannot serve TLS). Default to NOT setting these.
# ALLOW_RATE_LIMIT_DISABLED_IN_PRODUCTION=true
# ALLOW_DB_SSLMODE_DISABLE_IN_PRODUCTION=true

# --- Audit log retention ---
# Days an audit-log row is kept before the retention worker deletes it.
# DSGVO Art. 17 obligation; do not lower below 365 without legal review.
AUDIT_LOG_RETENTION_DAYS=730

# --- DB connection pool (tune for traffic) ---
# DB_MAX_IDLE_CONNS=10
# DB_MAX_OPEN_CONNS=100
# DB_CONN_MAX_LIFE_MIN=60
# DB_CONN_MAX_IDLE_MIN=10

# --- SMTP ---
SMTP_HOST=smtp.yourdomain.example
SMTP_PORT=587
SMTP_USER=kitamanager@yourdomain.example
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM=noreply@yourdomain.example

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json
