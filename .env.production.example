# KitaManager — production env template.
# Copy to `.env` and replace every REPLACE_ME. The API refuses to start if any
# required value is missing, shorter than the minimum, or matches a known
# placeholder string.

# --- Database ---
DB_HOST=postgres.internal
DB_PORT=5432
DB_USER=kitamanager
# Generate: openssl rand -hex 24
DB_PASSWORD=REPLACE_ME
DB_NAME=kitamanager
# Use verify-full when the DB has a verifiable cert, otherwise 'require'.
DB_SSLMODE=require

# --- Server ---
SERVER_PORT=8080

# --- Auth ---
# Generate: openssl rand -hex 32
# Must be at least 32 characters and not a known placeholder.
JWT_SECRET=REPLACE_ME
SECURE_COOKIES=true

# --- First-time admin seeding ---
# The seeded admin should rotate this password on first login.
SEED_ADMIN_EMAIL=admin@yourdomain.example
SEED_ADMIN_PASSWORD=REPLACE_ME
SEED_ADMIN_NAME=Administrator
SEED_RBAC_POLICIES=true
# Do not set SEED_TEST_DATA in production.
# SEED_TEST_DATA=false

# Optional: import default government funding plan at startup.
# GOVERNMENT_FUNDING_SEED_PATH=configs/government-fundings/berlin.yaml
# GOVERNMENT_FUNDING_SEED_STATE=berlin

# --- CORS ---
# Exact origins only. Wildcard (*) combined with credentials is rejected.
CORS_ALLOW_ORIGINS=https://kitamanager.yourdomain.example
CORS_ALLOW_CREDENTIALS=true

# --- Reverse proxy ---
# Comma-separated CIDRs of the proxies in front of the API. Without this, the
# app does not honor X-Forwarded-* headers.
TRUSTED_PROXIES=10.0.0.0/8

# --- Rate limiting ---
LOGIN_RATE_LIMIT_PER_MINUTE=5
API_RATE_LIMIT_PER_MINUTE=60

# --- SMTP ---
SMTP_HOST=smtp.yourdomain.example
SMTP_PORT=587
SMTP_USER=kitamanager@yourdomain.example
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM=noreply@yourdomain.example

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json
