# openapi-typescript@7 declares `peerDependencies: { typescript: "^5.x" }`,
# but the project tracks the latest TypeScript (currently 6.x). The
# generated TypeScript output is compatible with both — only the strict
# peer-dep declaration blocks installation. Allow the resolution to
# proceed; revisit when openapi-typescript ships a TS-6-compatible
# release. See CLAUDE.md > Dependency Versions for the policy.
legacy-peer-deps=true

# Do not resolve a package version until it has been on the registry for a
# week. `.github/dependabot.yml` already applies the same seven days to the
# PRs Dependabot raises; this is the other half, for the versions a person or
# an agent pulls in by hand with `npm install <pkg>` or `npm update`. Without
# it that path has no floor at all, and a lockfile edited locally is exactly
# how a package compromised an hour ago reaches the repo. Keeping it in the
# repo rather than in a personal ~/.npmrc is the point: a setting only one
# machine has protects only that machine.
#
# Measured, not assumed: npm 11 applies this during *resolution* only. `npm
# ci` installs the lockfile verbatim and ignores it, so CI cannot start
# failing over a version's age, and a Dependabot *security* PR -- exempt from
# the cooldown and so possibly hours old -- still installs and still merges.
#
# To take a release deliberately before the week is up, override per command
# (`npm install <pkg> --min-release-age=0`) rather than editing this file.
min-release-age=7
