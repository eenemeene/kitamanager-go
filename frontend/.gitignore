# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Testing
/coverage

# Next.js
/.next/
# Isolated build dirs. `next.config.ts` honours NEXT_DIST_DIR so a production
# build can be made and served without clobbering a running `make dev`;
# `make web-visual-baselines` uses `.next-baseline`, and ad-hoc probes use
# whatever name is to hand. Without this a stray `git add -A` commits a few
# thousand build artefacts.
/.next-*/
/out/

# Production
/build

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local env files
.env*.local
.env

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts
test-results/
