# Multi-stage build for the report-pdf tool.
# Produces a container that can generate PDF reports via Playwright.
# The tool is one-shot: external schedulers (cron, systemd timers,
# Kubernetes CronJob) drive recurring runs.
#
# Usage:
#   docker build -f Dockerfile.report -t kitamanager-report .
#   docker run --rm -v /tmp/reports:/output \
#     -e KITAMANAGER_REPORT_EMAIL=admin@example.com \
#     -e KITAMANAGER_REPORT_PASSWORD=secret \
#     -e KITAMANAGER_REPORT_ORG_ID=1 \
#     -e KITAMANAGER_REPORT_OUTPUT_DIR=/output \
#     kitamanager-report

# Stage 1: Build the Go binary
FROM cgr.dev/chainguard/go:latest AS builder

# Version triple injected via build args (the release workflow passes
# real values from `git describe`; defaults make a `docker build` from
# a working copy still produce a runnable binary). Kept identical to
# Dockerfile.api's pattern so a future operator only has to learn it once.
ARG GIT_VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_TIME=unknown

WORKDIR /app

# Copy go.mod/go.sum first for dependency caching
COPY tools/report-pdf/go.mod tools/report-pdf/go.sum ./
RUN go mod download

# Copy source and build with version info embedded.
COPY tools/report-pdf/ .
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo \
    -ldflags "-X github.com/eenemeene/kitamanager-go/tools/report-pdf/internal/version.GitVersion=${GIT_VERSION} -X github.com/eenemeene/kitamanager-go/tools/report-pdf/internal/version.GitCommit=${GIT_COMMIT} -X github.com/eenemeene/kitamanager-go/tools/report-pdf/internal/version.BuildTime=${BUILD_TIME}" \
    -o report-pdf .

# Stage 2: Runtime with Node.js (needed for Playwright browser management)
FROM cgr.dev/chainguard/node:latest-dev

WORKDIR /app

# Copy the Go binary
COPY --from=builder /app/report-pdf /usr/local/bin/report-pdf

# Install Playwright and Chromium browser
RUN npx playwright install chromium 2>/dev/null || true

ENTRYPOINT ["report-pdf"]
