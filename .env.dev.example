# KitaManager — local development env.
# Copy this file to `.env` and start the stack. The values here are intentionally
# insecure and must never be used outside a developer's local machine.

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=kitamanager
DB_PASSWORD=kitamanager
DB_NAME=kitamanager
DB_SSLMODE=disable

# --- Server ---
SERVER_PORT=8080

# --- Auth ---
# HMAC key used to derive the double-submit CSRF token from the session
# cookie value. Required, ≥32 characters, no known-placeholder strings.
# Generate even for local dev: openssl rand -hex 32
CSRF_HMAC_KEY=REPLACE_WITH: openssl rand -hex 32
# AES-256 key for TOTP secret encryption (64 hex chars = 32 bytes).
# Generate even for local dev: openssl rand -hex 32
# Uniform / all-same-byte values (e.g. 64x'1') are rejected at startup so
# a placeholder cannot accidentally ship to staging/production.
TOTP_ENCRYPTION_KEY=REPLACE_WITH: openssl rand -hex 32
# Shown in the user's authenticator app. Override per-tenant in prod.
TOTP_ISSUER=KitaManager (dev)
# Allow cookie delivery over plain HTTP so localhost dev works.
SECURE_COOKIES=false

# --- Seeding ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=supersecret
SEED_ADMIN_NAME=admin
SEED_RBAC_POLICIES=true
SEED_TEST_DATA=true
GOVERNMENT_FUNDING_SEED_PATH=configs/government-fundings/berlin.yaml
GOVERNMENT_FUNDING_SEED_STATE=berlin

# --- CORS ---
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# --- Rate limiting (disabled for dev; required > 0 in production) ---
LOGIN_RATE_LIMIT_PER_MINUTE=0
API_RATE_LIMIT_PER_MINUTE=0

# --- Logging ---
LOG_LEVEL=debug
LOG_FORMAT=text

# --- Optional ---
# TRUSTED_PROXIES=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=noreply@example.com
