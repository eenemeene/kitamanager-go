# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Build artifacts
bin/

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Cryptographic material — TLS certs, signing keys, private keys
# of any shape. We don't expect any of these to live in-tree
# (production loads them from secrets managers), so a tripwire is
# cheap defence-in-depth against an accidental `git add .`.
*.key
*.pem
*.crt
*.pfx
*.p12

# Editor/IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store

# Database backups
backups/

# Generated PDF reports
*.pdf

# Playwright test results
web/test-results/
# Playwright leaves visual-regression failure dumps in CWD when run
# from repo root (not from frontend/). Don't commit them.
visual-regression-*/

# Web build output (regenerated by make web-build)
internal/web/dist/*
!internal/web/dist/.gitkeep

# Pay plan data (imported via API, not committed)
configs/pay-plans/tv-eene-meene.yaml
configs/employees/eene-meene.yaml
configs/children/eene-meene.yaml

# Local notes
TODO.local
TODO.UX
TODO.report
