# Stage 1: Install dependencies
FROM cgr.dev/chainguard/node:latest-dev AS deps

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# Stage 2: Build the Next.js application
FROM cgr.dev/chainguard/node:latest-dev AS builder

WORKDIR /app

COPY --from=deps --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node frontend/ .

# BACKEND_URL is the server-side proxy target (used by Next.js rewrites at build time).
# Defaults to the Docker service name; override for other environments.
ARG BACKEND_URL=http://api:8080
ENV BACKEND_URL=${BACKEND_URL}

# Version triple — passed in at build time so Next.js's metadata API
# captures the real version into the statically-rendered <meta> tag
# during `npm run build`. Setting these in the runtime stage alone
# (the previous shape) would have made the build see "dev" and bake
# that into the static output, which was the bug v0.28.0 attempted
# to work around with `dynamic = 'force-dynamic'` at the root layout
# — and that change made the multi-arch arm64 build hang.
ARG APP_VERSION=dev
ARG APP_COMMIT=unknown
ARG APP_BUILD_TIME=unknown
ENV APP_VERSION=${APP_VERSION}
ENV APP_COMMIT=${APP_COMMIT}
ENV APP_BUILD_TIME=${APP_BUILD_TIME}

# Build with standalone output
RUN npm run build

# Stage 3: Production runtime
FROM cgr.dev/chainguard/node:latest

WORKDIR /app

# Copy standalone server and static assets
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

# Version triple — read at request time by the /version route handler
# so the frontend can advertise its build identity (independent of the
# API's, since they ship as separate images that may be at different
# versions). ARGs must be re-declared in this stage to inherit the
# values from `docker build --build-arg`. Defaults make local
# `docker build` from a working copy still produce something sensible.
ARG APP_VERSION=dev
ARG APP_COMMIT=unknown
ARG APP_BUILD_TIME=unknown
ENV APP_VERSION=${APP_VERSION}
ENV APP_COMMIT=${APP_COMMIT}
ENV APP_BUILD_TIME=${APP_BUILD_TIME}

# Expose port
EXPOSE 3000

ENV HOSTNAME=0.0.0.0
ENV PORT=3000

CMD ["server.js"]
